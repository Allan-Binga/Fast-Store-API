# Load backend/.env once through index.js; provide real secrets locally or in deployment.
NODE_ENV=development
PORT=5500
MONGO_URI=mongodb://127.0.0.1:27017/storeapi
CLIENT_URL=http://localhost:5173
ADMIN_CLIENT_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=
JWT_REFRESH_SECRET=
# Use separate random values for administrator sessions.
ADMIN_JWT_SECRET=
ADMIN_JWT_REFRESH_SECRET=
# Private key required in X-Admin-Registration-Key. Never expose it in Vite.
ADMIN_REGISTRATION_KEY=
# Optional integrations; required when the corresponding feature is used.
# Product image storage.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=
STRIPE_SECRET_KEY=
WEBHOOK_SECRET=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=info@fast-store.skirill.org
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
MPESA_CALLBACK_URL=
# Optional: multiply catalog totals before sending whole KES to STK Push.
MPESA_AMOUNT_MULTIPLIER=1
